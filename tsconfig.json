{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "paths": {
      "ng-easy-form-lib": ["./dist/ng-easy-form-lib/index.d.ts"]
    },
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "typeCheckHostBindings": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./projects/ng-easy-form-lib/tsconfig.lib.json"
    },
    {
      "path": "./projects/ng-easy-form-lib/tsconfig.spec.json"
    },
    {
      "path": "./projects/ng-easy-form-demo/tsconfig.app.json"
    },
    {
      "path": "./projects/ng-easy-form-demo/tsconfig.spec.json"
    }
  ]
}
